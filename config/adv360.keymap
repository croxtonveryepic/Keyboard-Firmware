#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none         &none         &kp N2   &kp N3    &kp N4     &kp N5  &kp C_MUTE                                                                            &kp C_PLAY_PAUSE  &kp N6   &kp N7  &kp N8      &kp N9       &none          &to 2
&mo 3         &kp NUMBER_1  &kp P    &kp L     &kp K      &kp Q   &kp C_VOLUME_UP                                                                       &kp C_NEXT        &kp G    &kp F   &kp A       &kp U        &kp N0         &mo 3
&kp X         &kp S         &kp N    &kp R     &kp T      &kp M   &kp C_VOLUME_DOWN  &kp SLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET  &kp GRAVE      &kp C_PREV        &kp Y    &kp C   &kp O       &kp I        &kp E          &kp J
&caps_word    &kp Z         &kp B    &kp H     &kp D      &kp V                                 &kp MINUS             &kp EQUAL                                           &kp SQT  &kp W   &kp PERIOD  &kp COMMA    &kp SEMICOLON  &kp BACKSLASH
&kp CAPSLOCK  &kp HOME      &kp END  &kp LEFT  &kp RIGHT          &lt 1 SPACE        &lt 2 TAB  &kp ESCAPE            &kp DELETE         &kp BACKSPACE  &kp ENTER                  &kp UP  &kp DOWN    &kp PAGE_UP  &kp PAGE_DOWN  &mo 0
            >;
        };

        Function_Keys {
            bindings = <
&trans  &trans        &trans        &trans     &trans          &trans  &trans                                      &trans  &trans   &trans   &trans  &trans  &trans   &trans
&trans  &trans        &trans        &trans     &trans          &trans  &trans                                      &trans  &kp F1   &kp F2   &kp F3  &kp F4  &trans   &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp F5   &kp F6   &kp F7  &kp F8  &kp F9   &kp F10
&trans  &trans        &trans        &trans     &trans          &trans                  &trans      &trans                  &kp F11  &kp F12  &kp F3  &kp F4  &kp F5   &kp F6
&trans  &trans        &trans        &trans     &trans                  &trans  &trans  &trans      &trans  &trans  &trans           &kp F7   &kp F8  &kp F9  &kp F10  &trans
            >;
        };

        Mouse_Keys {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans  &trans                                      &trans   &trans        &trans          &trans     &trans     &trans   &trans
&trans  &trans    &trans    &trans     &trans     &trans  &trans                                      &trans   &trans        &trans          &trans     &trans     &trans   &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &trans  &trans      &trans  &trans  &trans   &kp F17       &mkp LCLK       &mkp RCLK  &mkp MCLK  &kp F24  &trans
&trans  &trans    &trans    &kp LC(C)  &kp LC(V)  &trans                  &trans      &trans                   &msc SCRL_UP  &msc SCRL_DOWN  &trans     &trans     &trans   &trans
&trans  &trans    &trans    &trans     &trans             &trans  &trans  &trans      &trans  &trans  &kp F14                &trans          &trans     &trans     &trans   &trans
            >;
        };

        Meta_BT {
            display-name = "Mod";
            bindings = <
&none  &none  &none  &none  &none       &none  &none                                            &trans           &none           &none         &none         &none         &none         &none
&none  &none  &none  &none  &none       &none  &none                                            &bootloader      &studio_unlock  &none         &none         &none         &none         &none
&none  &none  &none  &none  &none       &none  &none  &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none  &macro_ver  &none                &none      &none                                    &none           &none         &none         &none         &none         &none
&none  &none  &none  &none  &none              &none  &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                  &bl BL_INC    &bl BL_DEC    &none         &none         &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
