    };

};
};


/ {
    macros {
        en_dash: en_dash {
            label = "EN_DASH";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N0>
                , <&macro_release &kp LALT>
                ;
        };

        em_dash: em_dash {
            label = "EM_DASH";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N1>
                , <&macro_release &kp LALT>
                ;
        };

    };
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE    &kp N1           &kp N2     &kp N3    &kp N4     &kp N5     &kp C_MUTE                                                               &kp C_PLAY_PAUSE  &kp N6     &kp N7  &kp N8    &kp N9       &kp N0              &kp DELETE
&mo 5         &kp PRINTSCREEN  &kp F      &kp M     &kp H      &en_dash      &kp C_VOLUME_UP                                                          &kp C_NEXT        &em_dash      &kp K   &kp W     &kp G        &kp K_CONTEXT_MENU  &mo 5  
&kp Z         &left_pinky LGUI N &left_ring1 LALT S &left_middy LCTRL T &left_index LSHFT R      &kp Q      &kp C_VOLUME_DOWN  &kp EQUAL  &kp HOME       &kp END        &kp SQT      &kp C_PREV        &kp J      &right_index LSHFT A &right_middy LCTRL E &right_ring1 LALT C &right_pinky LGUI I               &kp X
&kp LSHFT     &kp B            &kp V      &kp D     &kp L      &kp LCTRL(C)                                &kp GRAVE      &kp SEMICOLON                                 &kp LCTRL(V)  &kp O   &kp U     &kp P        &kp Y               &kp RSHFT
&kp CAPSLOCK  &kp PERIOD       &kp SLASH  &kp LEFT  &kp RIGHT             &lt 1 TAB        &lt 4 SPACE  &kp MINUS      &kp COMMA       &lt 2 BACKSPACE   &lt 3 ENTER             &kp UP  &kp DOWN  &kp PAGE_UP  &kp PAGE_DOWN       &tog 4
            >;
        };

        Number_Pad {
            bindings = <
&trans  &trans      &trans         &trans       &trans           &trans  &trans                                         &trans           &trans  &trans           &trans           &trans           &trans        &trans
&trans  &trans      &kp TILDE      &kp DOLLAR   &kp CARET        &trans  &trans                                         &trans           &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans        &trans
&trans  &kp LGUI    &kp LALT       &kp LCTRL    &kp LSHFT        &trans  &trans  &trans  &trans      &trans  &trans     &trans           &kp KP_NUMLOCK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PERCENT   &kp KP_ENTER
&trans  &kp COLON   &kp KP_MINUS   &kp KP_PLUS  &kp KP_ASTERISK  &trans                  &trans      &trans                              &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_EQUAL  &trans
&trans  &kp KP_DOT  &kp KP_DIVIDE  &trans       &trans                   &trans  &trans  &trans      &trans  &kp SPACE  &kp KP_NUMBER_0          &trans           &trans           &trans           &trans        &trans
            >;
        };

        Symbols {
            bindings = <
&trans  &trans            &trans             &trans                 &trans           &trans  &trans                                      &trans  &trans  &trans          &trans       &trans             &trans     &trans
